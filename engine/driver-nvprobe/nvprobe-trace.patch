-    down(&nvl->ldata_lock);
+    {
+        u64 nvp_t0 = ktime_get_ns();
+        if (down_trylock(&nvl->ldata_lock) != 0)
+        {
+            NVPROBE("CLOSE-CB llock wait-begin");
+            down(&nvl->ldata_lock);
+            NVPROBE("CLOSE-CB llock acquired wait=%llums",
