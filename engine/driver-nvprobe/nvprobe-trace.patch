+/*
+ * dsv41 NVPROBE (2026-11-17): 死机定位探针。
+ * 设备 open/close/锁等待全轨迹，printk 直出（netconsole/kmsg 均可捕获）。
+ * 频控设计：锁等待用 down_trylock 探测（无争用零输出）；RM 入口 5s 限频。
+ * 判读：死机后日志最后一条无配对 END 的 BEGIN 行 = 卡死现场（函数级）。
+ */
+#include <linux/ktime.h>
+#include <linux/semaphore.h>
+#include <linux/jiffies.h>
+#define NVPROBE(fmt, ...) \
+    printk(KERN_INFO "NVPROBE %s[%d] " fmt "\n", \
+           current->comm, (int)current->pid, ##__VA_ARGS__)
+static unsigned long nvp_last_rmcmd_jiffies;
 #include <linux/pci.h>
 #include <uapi/linux/pci_regs.h>
 
@@ -1153,7 +1167,14 @@ static nv_linux_state_t *find_minor(NvU32 minor)
     nvl = find_minor_locked(minor);
     if (nvl != NULL)
     {
-        down(&nvl->ldata_lock);
+        u64 nvp_t0 = ktime_get_ns();
+        if (down_trylock(&nvl->ldata_lock) != 0)
+        {
+            NVPROBE("FIND-MINOR llock wait-begin minor=%u", minor);
+            down(&nvl->ldata_lock);
+            NVPROBE("FIND-MINOR llock acquired wait=%llums",
+                    (ktime_get_ns() - nvp_t0) / 1000000LL);
+        }
     }
 
     UNLOCK_NV_LINUX_DEVICES();
@@ -1175,7 +1196,14 @@ static nv_linux_state_t *find_gpu_id(NvU32 gpu_id)
         nv_state_t *nv = NV_STATE_PTR(nvl);
         if (nv->gpu_id == gpu_id)
         {
-            down(&nvl->ldata_lock);
+            u64 nvp_t0 = ktime_get_ns();
+            if (down_trylock(&nvl->ldata_lock) != 0)
+            {
+                NVPROBE("FIND-GPUID llock wait-begin gpu_id=0x%x", gpu_id);
+                down(&nvl->ldata_lock);
+                NVPROBE("FIND-GPUID llock acquired wait=%llums",
+                        (ktime_get_ns() - nvp_t0) / 1000000LL);
+            }
             break;
         }
         nvl = nvl->next;
@@ -1201,7 +1229,16 @@ nv_linux_state_t *find_uuid(const NvU8 *uuid)
     for (nvl = nv_linux_devices; nvl; nvl = nvl->next)
     {
         nv = NV_STATE_PTR(nvl);
-        down(&nvl->ldata_lock);
+        {
+            u64 nvp_t0 = ktime_get_ns();
+            if (down_trylock(&nvl->ldata_lock) != 0)
+            {
+                NVPROBE("FIND-UUID llock wait-begin");
+                down(&nvl->ldata_lock);
+                NVPROBE("FIND-UUID llock acquired wait=%llums",
+                        (ktime_get_ns() - nvp_t0) / 1000000LL);
+            }
+        }
         dev_uuid = nv_get_cached_uuid(nv);
         if (dev_uuid && memcmp(dev_uuid, uuid, GPU_UUID_LEN) == 0)
             goto out;
@@ -1250,7 +1287,16 @@ static nv_linux_state_t *find_uuid_candidate(const NvU8 *uuid)
         for (nvl = nv_linux_devices; nvl; nvl = nvl->next)
         {
             nv = NV_STATE_PTR(nvl);
-            down(&nvl->ldata_lock);
+            {
+                u64 nvp_t0 = ktime_get_ns();
+                if (down_trylock(&nvl->ldata_lock) != 0)
+                {
+                    NVPROBE("FIND-UUUID-CAND llock wait-begin");
+                    down(&nvl->ldata_lock);
+                    NVPROBE("FIND-UUUID-CAND llock acquired wait=%llums",
+                            (ktime_get_ns() - nvp_t0) / 1000000LL);
+                }
+            }
             dev_uuid = nv_get_cached_uuid(nv);
             if (dev_uuid)
             {
@@ -1737,6 +1783,8 @@ static int nv_open_device(nv_state_t *nv, nvidia_stack_t *sp)
     int rc;
     NV_STATUS status;
 
+    NVPROBE("OPEN-DEV begin gpu_id=0x%llx", (unsigned long long)nv->gpu_id);
+
     if ((nv->flags & NV_FLAG_EXCLUDE) != 0)
     {
         char *uuid = rm_get_gpu_uuid(sp, nv);
@@ -1803,6 +1851,7 @@ static int nv_open_device(nv_state_t *nv, nvidia_stack_t *sp)
 
     atomic64_inc(&nvl->usage_count);
 
+    NVPROBE("OPEN-DEV end gpu_id=0x%llx", (unsigned long long)nv->gpu_id);
     return 0;
 }
 
@@ -1863,6 +1912,8 @@ static void nvidia_open_deferred(void *nvlfp_raw)
     nv_linux_state_t *nvl = nvlfp->deferred_open_nvl;
     int rc;
 
+    NVPROBE("OPEN-DEFER run");
+
     /*
      * Deferred opens and device removal are synchronized via
      * nvl->is_accepting_opens and nvl->open_q flushes so that nvl is
@@ -1877,7 +1928,16 @@ static void nvidia_open_deferred(void *nvlfp_raw)
      * So, it is safe to proceed without nv_system_pm_lock here (in fact, it
      * must not be taken to ensure nvl->open_q can make forward progress).
      */
-    down(&nvl->ldata_lock);
+    {
+        u64 nvp_t0 = ktime_get_ns();
+        if (down_trylock(&nvl->ldata_lock) != 0)
+        {
+            NVPROBE("OPEN-DEFER llock wait-begin");
+            down(&nvl->ldata_lock);
+            NVPROBE("OPEN-DEFER llock acquired wait=%llums",
+                    (ktime_get_ns() - nvp_t0) / 1000000LL);
+        }
+    }
     rc = nv_open_device_for_nvlfp(NV_STATE_PTR(nvl), nvlfp->sp, nvlfp);
 
     /* Only add open file tracking where nvl->usage_count is incremented */
@@ -1953,6 +2013,8 @@ nvidia_open(
     nv_linux_file_private_t *nvlfp = NULL;
     nvidia_stack_t *sp = NULL;
 
+    NVPROBE("OPEN begin");
+
     nv_printf(NV_DBG_INFO, "NVRM: nvidia_open...\n");
 
     nvlfp = nv_alloc_file_private();
@@ -1979,6 +2041,7 @@ nvidia_open(
         rc = nvidia_ctl_open(inode, file);
         if (rc != 0)
             goto failed;
+        NVPROBE("OPEN ctl end rc=%d", rc);
         return rc;
     }
 
@@ -2040,6 +2103,7 @@ nvidia_open(
         if (!nvl->is_accepting_opens)
         {
             /* Background kthread is not accepting opens, bail! */
+            NVPROBE("OPEN defer-reject busy");
             rc = -EBUSY;
             goto nonblock_end;
         }
@@ -2058,6 +2122,8 @@ nvidia_open(
             rc = -EBUSY;
         }
 
+        NVPROBE("OPEN defer scheduled=%d", item_scheduled);
+
 nonblock_end:
         up(&nvl->open_q_lock);
         UNLOCK_NV_LINUX_DEVICES();
@@ -2074,6 +2140,7 @@ failed:
         }
     }
 
+    NVPROBE("OPEN end rc=%d", rc);
     return rc;
 }
 
@@ -2249,6 +2316,8 @@ nvidia_close_callback(
     nvidia_stack_t *sp = nvlfp->sp;
     NvBool bRemove = NV_FALSE;
 
+    NVPROBE("CLOSE-CB begin");
+
     nvl = nvlfp->nvptr;
     if (nvl == NULL)
     {
@@ -2270,8 +2339,19 @@ nvidia_close_callback(
