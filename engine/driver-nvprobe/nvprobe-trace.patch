               (atomic64_read(&nvl->usage_count) == 0) &&
@@ -2333,12 +2413,15 @@ nvidia_close(
     int rc;
     nv_linux_file_private_t *nvlfp = NV_GET_LINUX_FILE_PRIVATE(file);
 
+    NVPROBE("CLOSE begin");
+
     nv_printf(NV_DBG_INFO,
               "NVRM: nvidia_close on GPU with minor number %d\n",
               NV_DEVICE_MINOR_NUMBER(inode));
 
     if (nv_is_control_device(inode))
     {
+        NVPROBE("CLOSE ctl end");
         return nvidia_ctl_close(inode, file);
     }
 
@@ -2365,6 +2448,7 @@ nvidia_close(
         WARN_ON(rc == 0);
     }
 
+    NVPROBE("CLOSE end");
     return 0;
 }
 
@@ -2898,9 +2982,24 @@ unlock:
         }
 
         default:
+        {
+            u64 nvp_t0 = ktime_get_ns();
+            if (time_after(jiffies, nvp_last_rmcmd_jiffies + 5 * HZ))
+            {
+                nvp_last_rmcmd_jiffies = jiffies;
+                NVPROBE("RMCMD begin cmd=0x%x", arg_cmd);
+            }
             rmStatus = rm_ioctl(sp, nv, &nvlfp->nvfp, arg_cmd, arg_copy, arg_size);
+            {
+                u64 nvp_ms = (ktime_get_ns() - nvp_t0) / 1000000LL;
+                if (nvp_ms > 100)
+                {
+                    NVPROBE("RMCMD slow cmd=0x%x took=%llums", arg_cmd, nvp_ms);
+                }
+            }
             status = ((rmStatus == NV_OK) ? 0 : -EINVAL);
             break;
+        }
     }
 
 done:
